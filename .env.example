DATABASE_URL=postgresql://user:password@localhost:5432/indira_naturals

# ---- Auth / Sessions ----
AUTH_SECRET=replace-with-a-long-random-string

# ---- Default admin bootstrap (used once by `npx tsx scripts/seed.ts`) ----
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=choose-a-strong-password

# ---- Razorpay ----
# Test keys: https://dashboard.razorpay.com/app/keys (toggle "Test Mode")
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Dashboard > Account & Settings > Webhooks > Add new webhook pointing at /api/razorpay/webhook
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx

# ---- Business details ----
NEXT_PUBLIC_SITE_NAME=Indira Naturals
NEXT_PUBLIC_SITE_URL=https://yourdomain.com
NEXT_PUBLIC_SUPPORT_EMAIL=hello@yourdomain.com
NEXT_PUBLIC_SUPPORT_PHONE=+91-00000-00000

# Flat shipping fee + free shipping threshold, both in paise (INR smallest unit)
SHIPPING_FEE_PAISE=4900
FREE_SHIPPING_THRESHOLD_PAISE=99900
